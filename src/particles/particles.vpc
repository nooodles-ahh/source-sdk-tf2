//-----------------------------------------------------------------------------
//	GAMEUI_STUB.VPC
//
//	Project Script
//-----------------------------------------------------------------------------
$Macro SRCDIR		".."
$Include "$SRCDIR\vpc_scripts\source_lib_base.vpc"


$Configuration
{

	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;.\;$SRCDIR\public\particles;$SRCDIR\public"
		$PreprocessorDefinitions		"$BASE;"
	}

}

$Project "Particles"
{
	$Folder "Source Files"
	{
		$File	"particles.cpp" \
				"particlecollection.cpp" \
				"psheet.cpp" \
				"constraint_worldcollide.cpp"\
				"render_points.cpp" \
				"render_sprites.cpp"
	}

	$Folder "Header Files"
	{
		$File	"builtin_constraints.h" \
				"builtin_emitters.h" \
				"builtin_forces.h" \
				"builtin_renderops.h" \
				"psheet.h"
	}
}
