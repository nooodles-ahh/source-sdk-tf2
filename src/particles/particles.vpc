//-----------------------------------------------------------------------------
//	GAMEUI_STUB.VPC
//
//	Project Script
//-----------------------------------------------------------------------------
$Macro SRCDIR		".."
$Include "$SRCDIR\vpc_scripts\source_lib_base.vpc"


$Configuration
{

	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;.\;$SRCDIR\public\particles;$SRCDIR\public"
		$PreprocessorDefinitions		"$BASE;"
	}

}

$Project "Particles"
{
	$Folder "Source Files"
	{
		$Folder "Particles"
		{
			$File	"particles.cpp" \
					"particlesystemdict.cpp" \
					"particlecollection.cpp"
		}
	
		$File	"addbuiltin_ops.cpp" \
				"builtin_constraints.cpp" \
				"builtin_initializers.cpp" \
				"builtin_particle_emitters.cpp" \
				"builtin_particle_forces.cpp" \
				"builtin_particle_ops.cpp" \
				"builtin_particle_render_ops.cpp" \
				"particle_sort.cpp" \
				"psheet.cpp"
	}

	$Folder "Header Files"
	{
		$File	"particlesystemdict.h" \
				"builtin_emitters.h" \
				"builtin_forces.h" \
				"builtin_renderops.h" \
				"psheet.h"
	}
}
